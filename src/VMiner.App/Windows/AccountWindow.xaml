<Window x:Class="VMiner.Windows.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VMiner account" Width="470" Height="430"
        MinWidth="430" MinHeight="400"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="VMINER ACCOUNT" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}" />
            <TextBlock Margin="0,8,0,0" Text="Sign in to sync your vocabulary"
                       FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="Your collection is private and linked to your account. Passwords are sent directly to Supabase and are never stored by VMiner." />
        </StackPanel>

        <Label Grid.Row="1" Content="Email" Margin="0,22,0,6" />
        <TextBox x:Name="EmailBox" Grid.Row="2" FontSize="14"
                 AutomationProperties.Name="Email address" />

        <Label Grid.Row="3" Content="Password" Margin="0,15,0,6" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="4" MinHeight="36"
                     Padding="10,5" FontSize="14"
                     Background="{StaticResource InputBrush}"
                     Foreground="{StaticResource ForegroundBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     AutomationProperties.Name="Password" />

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,14,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="6" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CreateAccountButton" Content="Create account"
                    Click="CreateAccountClicked" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Click="CancelClicked" Margin="0,0,9,0" />
                <Button x:Name="SignInButton" Content="Sign in"
                        Click="SignInClicked" IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
