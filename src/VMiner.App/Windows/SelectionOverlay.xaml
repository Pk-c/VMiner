<Window x:Class="VMiner.Windows.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True">
    <Canvas x:Name="Surface" IsHitTestVisible="False">
        <Rectangle x:Name="SelectionRectangle" Stroke="#F2A23A" StrokeThickness="2"
                   Fill="#01000000" />
        <Border x:Name="SizeBadge" Background="#EB1D1715" CornerRadius="3" Padding="6,2">
            <TextBlock x:Name="SizeText" Foreground="#FFF3E7" FontSize="12" />
        </Border>
    </Canvas>
</Window>
