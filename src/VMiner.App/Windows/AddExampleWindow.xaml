<Window x:Class="VMiner.Windows.AddExampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add example sentence" Width="620" Height="500"
        MinWidth="540" MinHeight="440"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="ADD EXAMPLE SENTENCE" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource MutedBrush}" />

        <StackPanel Grid.Row="1" Margin="0,15,0,0">
            <TextBlock x:Name="DefinitionText" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="WordReadingText" Margin="0,4,0,0"
                       FontFamily="Yu Gothic UI" FontSize="13"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Label Grid.Row="2" Content="Japanese sentence" Margin="0,17,0,5" />
        <TextBox x:Name="JapaneseSentenceBox" Grid.Row="3"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Yu Gothic UI" />

        <Label Grid.Row="4" Content="English translation" Margin="0,13,0,5" />
        <TextBox x:Name="EnglishSentenceBox" Grid.Row="5"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Click="CancelClicked" Margin="0,0,9,0" />
                <Button x:Name="AddButton" Content="Add example" Click="AddClicked"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
